{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["index.ts", "scripts/memory-diag.ts", "scripts/memory-diag/**/*.ts", "src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
